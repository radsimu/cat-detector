# Camera stream (RTSP, HTTP, or local device index)
CAMERA_URL=0
# Examples:
# CAMERA_URL=rtsp://user:pass@192.168.1.100:554/stream
# CAMERA_URL=/path/to/video.mp4

# Camera reconnect settings
CAMERA_RECONNECT_MAX_DELAY=60       # Maximum backoff delay (seconds) when camera connection is lost

# Detection settings
DETECTION_MODEL=yolov8x.pt          # yolov8n/s/m/l/x -- trade speed for accuracy
DETECTION_CONFIDENCE=0.35           # Minimum confidence threshold (0.0-1.0)
DETECTION_INTERVAL_SECONDS=5        # How often to sample a frame from the stream
WEBHOOK_COOLDOWN_SECONDS=300        # Minimum time between consecutive webhook calls
WEBHOOK_MIN_CONSECUTIVE_FRAMES=2    # Consecutive qualifying frames required to fire
WEBHOOK_MIN_CONFIDENCE=0.5          # Min max_cat_confidence to fire (>= detection_confidence)
SPRINKLER_DURATION_SECONDS=10       # How long the sprinkler runs per trigger (1-300s)
SAVE_HUMAN_ONLY_FRAMES=false        # Save frames that only contain humans (no animals)

# Webhook
WEBHOOK_URL=                        # POSTed on cat detected (e.g. IFTTT "open valve" or SmartThings API)
WEBHOOK_OFF_URL=                    # POSTed sprinkler_duration_seconds later (leave blank if valve auto-closes)
WEBHOOK_SECRET=                     # Optional: added as X-Webhook-Secret header

# Storage
DATABASE_URL=sqlite:///./cat_detector.db
FRAMES_DIR=./data/frames            # Where detection frames are saved

# Web UI
HOST=0.0.0.0
PORT=8000
